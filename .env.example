# Copie para .env e preencha com os valores reais. Nunca commite o .env.

SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Chave secreta do servidor (Project Settings -> API -> service_role). Nunca expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=""

# Web Push (VAPID) — opcional, necessário só para notificações push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"

# E-book (pagina /ebook). Servidor apenas. Ver docs/ebook/apps-script.gs.
EBOOK_APPS_SCRIPT_URL=
EBOOK_APPS_SCRIPT_SECRET=
# Chave aleatoria longa que assina o link de download (ex.: openssl rand -hex 32).
EBOOK_TOKEN_SECRET=
# Opcional: Cloudflare Turnstile (verificacao server-side).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
